// Place your key bindings in this file to override the defaults
[
    {
        "key": "alt+up",
        "command": "-editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+down",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+down",
        "command": "-editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+w",
        "command": "-workbench.action.switchWindow"
    },
    {
        "key": "ctrl+w",
        "command": "deleteWordLeft",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "alt+backspace",
        "command": "-deleteWordLeft",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "ctrl+alt+w",
        "command": "deleteWordRight",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "alt+delete",
        "command": "-deleteWordRight",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "ctrl+alt+b",
        "command": "cursorWordLeft",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+alt+f",
        "command": "cursorWordRight",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords && !inlineSuggestionVisible"
    },
    {
        "key": "alt+k",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+k",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+j",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+j",
        "command": "editor.action.smartSelect.shrink",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+k",
        "command": "editor.action.smartSelect.grow",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+alt+cmd+d",
        "command": "workbench.action.debug.run",
        "when": "debuggersAvailable && !inDebugMode && !terminalFocus"
    },
    {
        "key": "ctrl+d",
        "command": "-workbench.action.debug.run",
        "when": "debuggersAvailable && !inDebugMode && !terminalFocus"
    },
    {
        "key": "f3 .",
        "command": "workbench.action.chat.toggleAgentMode",
        "when": "chatIsEnabled && !chatSessionRequestInProgress"
    },
    {
        "key": "ctrl+shift+alt+cmd+enter",
        "command": "github.copilot.git.generateCommitMessage"
    },
    {
        "key": "ctrl+shift+alt+cmd+s",
        "command": "workbench.action.splitEditor"
    },
    {
        "key": "shift+cmd+k",
        "command": "git.push"
    },
    {
        "key": "ctrl+shift+alt+cmd+tab",
        "command": "workbench.action.focusNextGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+tab",
        "command": "-workbench.action.focusNextGroup",
        "when": "editorFocus"
    },
    {
        "key": "cmd+k shift+cmd+w",
        "command": "-workbench.action.closeAllGroups"
    },
    {
        "key": "shift+cmd+w",
        "command": "-workbench.action.closeWindow"
    },
    {
        "key": "shift+cmd+w",
        "command": "workbench.action.closeEditorsInGroup"
    },
    {
        "key": "cmd+k w",
        "command": "-workbench.action.closeEditorsInGroup"
    },
    {
        "key": "cmd+s cmd+t",
        "command": "git.stageAll",
        "when": "config.git.untrackedChanges == 'mixed' && scmProvider == 'git' && scmResourceGroup == 'workingTree'"
    },
    // Copilot Chat: Disable default Enter submit behavior (except for commands and suggestions)
    {
        "key": "enter",
        "command": "-workbench.action.chat.submit",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached) && !suggestWidgetVisible && !chatInputHasSlashCommand"
    },
    {
        "key": "cmd+enter",
        "command": "-workbench.action.chat.submitWithCodebase",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    // Copilot Chat: Setup new bindings
    {
        "key": "cmd+enter",
        "command": "workbench.action.chat.submit",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    {
        "key": "cmd+shift+enter",
        "command": "workbench.action.chat.submitWithCodebase",
        "when": "inChatInput && (chatInputHasText || chatInstructionsAttached)"
    },
    {
        "key": "enter",
        "command": "editor.action.insertLineAfter",
        "when": "inChatInput && !suggestWidgetVisible && !chatInputHasSlashCommand"
    }
]