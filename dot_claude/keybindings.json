{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "shift+down": "scroll:lineDown",
        "shift+up": "scroll:lineUp"
      }
    },
    {
      "context": "Chat",
      "bindings": {
        "ctrl+;": "voice:pushToTalk"
      }
    }
  ]
}
