[user]
	email = yasuaki640@gmail.com
	name = yasuaki640
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
	ignorecase = false
[alias]
	st = status
	cm = commit -m
	br = branch
	cma = commit --amend --no-edit
	co = checkout
	cp = cherry-pick
	pl = pull
	ps = push
	lg = log --all --graph --oneline --format='%C(auto) %x09 %d [%h] [%cd] %s' --date=format:'%Y/%m/%d %H:%M'
	df = diff
	ada = add .
	dfc = diff --cached
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
# If pager is delta, it doesn't seem to make sense, but leave it.
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
