function zn() {
  local slug="$1"
  if [ -z "$slug" ]; then
    echo "Usage: zn <slug>"
    return 1
  fi

  local zenn_repo="$HOME/ghq/github.com/yasuaki640/zenn-articles"

  cd "$zenn_repo"
  npx zenn new:article --slug "$slug"
  code "$zenn_repo"
}

# lc : LeetCode(Go) の repo に移動して VS Code で開く
function lc() {
  local leetcode_repo="$HOME/ghq/github.com/yasuaki640/leetcode-go"

  cd "$leetcode_repo" || return 1
