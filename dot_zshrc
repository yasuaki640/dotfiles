# Amazon Q pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"
# Q pre block. Keep at the top of this file.

alias ls='eza --icons'
alias ll='ls -la'
alias g='git'
alias cdr='cd "$(git rev-parse --show-toplevel)"'
alias cdf='dir=$(ghq list --full-path | fzf --preview "bat --color=always --line-range :80 {}/README.*" --preview-window bottom) && [ -n "$dir" ] && cd "$dir"'
alias tf='terraform'
alias tg='terragrunt'
alias c='claude'
alias cm='chezmoi'
alias cs='cursor'
alias csa='cursor-agent'


HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

function gitignoreio() { curl -sLw "\n" https://www.toptal.com/developers/gitignore/api/$@ ;}

function touchp() {
  for f in "$@"; do
    mkdir -p "$(dirname "$f")"
    touch "$f"
  done
}

# open warp
function warp() {
  local target_path=$(realpath "$1")
  open "warp://action/new_tab?path=$target_path" &
}

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
. /opt/homebrew/opt/asdf/libexec/asdf.sh

eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"

# enable mysql client
export PATH=$PATH:/Applications/MySQLWorkbench.app/Contents/MacOS

if [[ $TERM_PROGRAM != "WarpTerminal" ]]; then
  eval "$(starship init zsh)"
fi

# zsh autocompletions setup
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

  autoload -Uz compinit
  compinit
fi

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

function zn() {
  local slug="$1"
  if [ -z "$slug" ]; then
    echo "Usage: zn <slug>"
    return 1
  fi

  local zenn_repo="$HOME/ghq/github.com/yasuaki640/zenn-articles"

  cd "$zenn_repo"
  npx zenn new:article --slug "$slug"
  code "$zenn_repo"
}

# Amazon Q post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"
