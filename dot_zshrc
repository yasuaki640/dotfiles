function gitignoreio() { curl -sLw "\n" https://www.toptal.com/developers/gitignore/api/$@ ;}

function touchp() {
  for f in "$@"; do
    mkdir -p "$(dirname "$f")"
    touch "$f"
  done
}

# open warp
function warp() {
  local target_path=$(realpath "$1")
  open "warp://action/new_tab?path=$target_path" &
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

